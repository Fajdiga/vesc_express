# sdkconfig.defaults for ESP32-C6 builds (e.g. JFBMS_MASTER_C6)
#
# This file is auto-loaded by ESP-IDF on top of sdkconfig.defaults when
# IDF_TARGET=esp32c6. Keys here override the common defaults.
#
# Most BT/BLE/WiFi/PHY keys in sdkconfig.defaults are still valid on C6 because
# both C3 and C6 use the standard esp_wifi APIs. C6 has additional radios
# (802.15.4) but they are disabled by default unless we opt in. Anything
# chip-specific that needs to differ from C3 lives below.

# Console: ESP32-C6-MINI-N4 has built-in USB-Serial-JTAG (same as C3/S3)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

# CPU frequency - C6 supports 160 MHz max
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# --- Bluetooth host stack: NimBLE (saves ~250 KB flash vs Bluedroid) ---
# C3 builds keep Bluedroid (sdkconfig.defaults). C6 alone uses NimBLE; the
# CMake selector in main/CMakeLists.txt picks comm_ble_nimble.c +
# custom_ble_nimble.c when CONFIG_BT_NIMBLE_ENABLED=y.
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_DEBUG=n

# Use a C6-specific partition table with larger OTA slots (the C6 firmware
# image with NimBLE+WiFi is ~1.5 MB, which still doesn't fit C3's 1600 KB
# OTA slots — and we keep the larger 1856 KB slots for headroom).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition_ota_c6.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition_ota_c6.csv"
