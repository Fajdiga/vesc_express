<?xml version="1.0" encoding="UTF-8"?>
<ConfigParams>
    <Params>
        <config_name>
            <longName>none</longName>
            <type>3</type>
            <transmittable>0</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine></cDefine>
            <valString>main_config_t</valString>
            <maxLen>0</maxLen>
        </config_name>
        <hw_name>
            <longName>JFBMS Master</longName>
            <type>0</type>
            <transmittable>0</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;JetFleet BMS Master - Receives data from BMS slave modules via CAN bus.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine></cDefine>
        </hw_name>
        <num_slaves>
            <longName>Number of Slaves</longName>
            <type>2</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Number of expected slave modules on the CAN bus (1-8).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>CONF_NUM_SLAVES</cDefine>
            <editorScale>1</editorScale>
            <editAsPercentage>0</editAsPercentage>
            <maxInt>8</maxInt>
            <minInt>1</minInt>
            <showDisplay>0</showDisplay>
            <stepInt>1</stepInt>
            <valInt>1</valInt>
            <suffix></suffix>
            <vTx>4</vTx>
        </num_slaves>
        <can_baud_rate>
            <longName>CAN Baud Rate</longName>
            <type>4</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Sans Serif';&quot;&gt;CAN-bus baud rate. Must match slave BMS modules. Protocol specifies 500 kbps.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>CONF_CAN_BAUD_RATE</cDefine>
            <valInt>2</valInt>
            <enumNames>CAN_BAUD_125K</enumNames>
            <enumNames>CAN_BAUD_250K</enumNames>
            <enumNames>CAN_BAUD_500K</enumNames>
            <enumNames>CAN_BAUD_1M</enumNames>
            <enumNames>CAN_BAUD_10K</enumNames>
            <enumNames>CAN_BAUD_20K</enumNames>
            <enumNames>CAN_BAUD_50K</enumNames>
            <enumNames>CAN_BAUD_75K</enumNames>
            <enumNames>CAN_BAUD_100K</enumNames>
        </can_baud_rate>
        <slave_timeout_ms>
            <longName>Slave Timeout (ms)</longName>
            <type>2</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Sans Serif';&quot;&gt;Time in milliseconds after which a slave is considered offline if no data received.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>CONF_SLAVE_TIMEOUT_MS</cDefine>
            <editorScale>1</editorScale>
            <editAsPercentage>0</editAsPercentage>
            <maxInt>10000</maxInt>
            <minInt>100</minInt>
            <showDisplay>0</showDisplay>
            <stepInt>100</stepInt>
            <valInt>1000</valInt>
            <suffix> ms</suffix>
            <vTx>1</vTx>
        </slave_timeout_ms>
    </Params>
    <SerOrder>
        <ser>num_slaves</ser>
        <ser>can_baud_rate</ser>
        <ser>slave_timeout_ms</ser>
    </SerOrder>
    <Grouping>
        <group>
            <groupName>General</groupName>
            <subgroup>
                <subgroupName>CAN Configuration</subgroupName>
                <subgroupParams>
                    <param>num_slaves</param>
                    <param>can_baud_rate</param>
                    <param>slave_timeout_ms</param>
                </subgroupParams>
            </subgroup>
        </group>
    </Grouping>
</ConfigParams>
